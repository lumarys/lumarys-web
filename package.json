{
  "name": "lumarys-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:videos": "node scripts/verify-videos.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "content:lint": "node scripts/content-lint.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:lint",
    "prebuild": "node scripts/gen-seo.mjs",
    "bundle:api": "node scripts/bundle-lambda.mjs services/progress-api",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.4",
    "next-mdx-remote": "^5.0.0",
