{
  "name": "lumarys-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:videos": "node scripts/verify-videos.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:exames": "node scripts/verify-exames.mjs",
    "content:lint": "node scripts/content-lint.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:lint",
    "prebuild": "npm run generate",
    "bundle:api": "node scripts/bundle-lambda.mjs services/progress-api",
    "test:e2e": "playwright test",
    "generate": "node scripts/gen-seo.mjs",
    "predev": "npm run generate",
    "pretypecheck": "npm run generate",
    "postbuild": "node scripts/og-extensao.mjs && node scripts/gen-feed.mjs && node scripts/sw.mjs && node scripts/csp.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "gray-matter": "^4.0.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.716.0",
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/lib-dynamodb": "^3.716.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
